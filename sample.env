# Local demo configuration. Copy to .env for a live run.
# These values are demonstration tokens, not production secrets.

EVENTS_CSV=data/events.csv

MCP_URL=http://127.0.0.1:8000/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8000

COORDINATOR_URL=http://127.0.0.1:8001
COORDINATOR_HOST=127.0.0.1
COORDINATOR_PORT=8001

DIAGNOSIS_URL=http://127.0.0.1:8002
DIAGNOSIS_HOST=127.0.0.1
DIAGNOSIS_PORT=8002

REPAIR_URL=http://127.0.0.1:8003
REPAIR_HOST=127.0.0.1
REPAIR_PORT=8003

FETCH_URL=http://127.0.0.1:8004
FETCH_HOST=127.0.0.1
FETCH_PORT=8004

# OpenAI-compatible chat API. The coordinator uses this to choose an agent card.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Scope agent:delegate. Presented by the coordinator to a specialist.
AGENT_DELEGATE_TOKEN=demo-delegate-token

# Scope tools:events:read. Presented by the diagnosis agent to MCP.
MCP_READ_TOKEN=demo-events-read-token

# Scope tools:events:write. Presented by the repair agent to MCP.
# The browser and the diagnosis agent do not receive this token.
MCP_WRITE_TOKEN=demo-events-write-token
